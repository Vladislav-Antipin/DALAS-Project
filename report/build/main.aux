\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Complete pipeline overview for drug repurposing prediction. Five public biomedical databases provide the raw data, which is transformed into three feature categories plus labels. The yellow Labels box is distinguished because it represents the target variable derived from clinical trial outcomes using heuristic rules, unlike the objectively measured features.}}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig:pipeline-balanced}{{3}{5}{Complete pipeline overview for drug repurposing prediction. Five public biomedical databases provide the raw data, which is transformed into three feature categories plus labels. The yellow Labels box is distinguished because it represents the target variable derived from clinical trial outcomes using heuristic rules, unlike the objectively measured features}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.4}Biological Rationale: The Drug--Pathway--Disease Network}{5}{subsection.1.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Tripartite graph representing the biological relationship between drugs, pathways, and diseases. Drugs (left, blue) interact with biological pathways (center, green) by modulating their activity. Pathways, in turn, are implicated in diseases (right, red) when their dysregulation contributes to pathology. This structure enables drug repurposing: if drug $d_1$ modulates pathway $p_2$, and $p_2$ is implicated in disease $y_2$, then $d_1$ is a candidate for treating $y_2$. Our pathway similarity feature captures the overlap between drug-associated and disease-associated pathways.}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:tripartite}{{4}{6}{Tripartite graph representing the biological relationship between drugs, pathways, and diseases. Drugs (left, blue) interact with biological pathways (center, green) by modulating their activity. Pathways, in turn, are implicated in diseases (right, red) when their dysregulation contributes to pathology. This structure enables drug repurposing: if drug $d_1$ modulates pathway $p_2$, and $p_2$ is implicated in disease $y_2$, then $d_1$ is a candidate for treating $y_2$. Our pathway similarity feature captures the overlap between drug-associated and disease-associated pathways}{figure.caption.7}{}}
