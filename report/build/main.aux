\newlabel{fig:pipeline-simple}{{1}{4}{Simplified pipeline overview showing the three main stages of our drug repurposing prediction system. Data from multiple biomedical databases is processed into numerical features, which are then used to train machine learning models. The Labels box (yellow) represents the target variable---trial success or failure---derived from clinical trial outcomes using heuristic rules we defined}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Same as Figure~\ref {fig:pipeline-detailed} but with labels having white backgrounds to create visual ``gaps'' where arrows pass behind text.}}{4}{figure.caption.5}\protected@file@percent }
