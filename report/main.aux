\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Simplified pipeline overview showing the three main stages of our drug repurposing prediction system. Data from multiple biomedical databases is processed into numerical features, which are then used to train machine learning models. The Labels box (yellow) represents the target variable---trial success or failure---derived from clinical trial outcomes using heuristic rules we defined.}}{3}{figure.caption.4}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pipeline-simple}{{1}{3}{Simplified pipeline overview showing the three main stages of our drug repurposing prediction system. Data from multiple biomedical databases is processed into numerical features, which are then used to train machine learning models. The Labels box (yellow) represents the target variable---trial success or failure---derived from clinical trial outcomes using heuristic rules we defined}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Detailed data flow with reorganized layout. UniProt provides pathway mappings for drugs, diseases, and their similarity. ClinicalTrials provides both trial dates (for Drug--Disease) and outcomes (for Labels).}}{3}{figure.caption.5}\protected@file@percent }
\newlabel{fig:pipeline-detailed}{{2}{3}{Detailed data flow with reorganized layout. UniProt provides pathway mappings for drugs, diseases, and their similarity. ClinicalTrials provides both trial dates (for Drug--Disease) and outcomes (for Labels)}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Same as Figure~\ref {fig:pipeline-detailed} but with labels having white backgrounds to create visual ``gaps'' where arrows pass behind text.}}{4}{figure.caption.6}\protected@file@percent }
\newlabel{fig:pipeline-gaps}{{3}{4}{Same as Figure~\ref {fig:pipeline-detailed} but with labels having white backgrounds to create visual ``gaps'' where arrows pass behind text}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Detailed pipeline showing data flow from sources to features. Arrows indicate which databases contribute to each feature category. UniProt provides pathway mappings used across drug, disease, and pair features. ClinicalTrials provides both trial metadata and outcome labels.}}{4}{figure.caption.7}\protected@file@percent }
\newlabel{fig:pipeline-final}{{4}{4}{Detailed pipeline showing data flow from sources to features. Arrows indicate which databases contribute to each feature category. UniProt provides pathway mappings used across drug, disease, and pair features. ClinicalTrials provides both trial metadata and outcome labels}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Complete pipeline overview for drug repurposing prediction. Five public biomedical databases provide the raw data, which is transformed into three feature categories plus labels. The yellow Labels box is distinguished because it represents the target variable derived from clinical trial outcomes using heuristic rules, unlike the objectively measured features.}}{5}{figure.caption.8}\protected@file@percent }
\newlabel{fig:pipeline-balanced}{{5}{5}{Complete pipeline overview for drug repurposing prediction. Five public biomedical databases provide the raw data, which is transformed into three feature categories plus labels. The yellow Labels box is distinguished because it represents the target variable derived from clinical trial outcomes using heuristic rules, unlike the objectively measured features}{figure.caption.8}{}}
