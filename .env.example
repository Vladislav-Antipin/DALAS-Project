# API Keys and Configuration
# Copy this file to .env and fill in your actual values

# DrugBank API (requires academic account verification)
DRUGBANK_USERNAME=your_username
DRUGBANK_PASSWORD=your_password

# OpenFDA API (no key required but rate limits apply)
# OPENFDA_API_KEY=optional_key_for_higher_limits

# Europe PMC API (no key required)

# Paths
DATA_DIR=./data
CACHE_DIR=./data/cache
RESULTS_DIR=./results
